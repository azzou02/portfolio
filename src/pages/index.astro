---
import Base from '../layouts/Base.astro';
import AsciiCam from '../components/AsciiCam.astro';
import CaseCard from '../components/CaseCard.astro';
import Ticker from '../components/Ticker.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base darkFooter>
  <main class="home">
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__cam"><AsciiCam /></div>

        <div class="hero__text">
          <h1 class="hero__title">I create for humans</h1>
          <p class="hero__lead">Alison is a software engineer and designer that loves creating for humans.</p>
        </div>
      </div>
    </section>

    <Ticker text="please scroll down to see my work hehehe (ﾉ◕ヮ◕)ﾉ*:・ﾟ✧ " 
            small="(ﾉ◕ヮ◕)ﾉ*:・ﾟ✧"
            gap={2} 
            size={60} 
            speed={0.5} 
    />

    <section class="projects" aria-label="Projects">
      <div class="projects__grid">
        <p class="landing__text">projects</p>
        {projects.map((p) => <CaseCard slug={p.id} data={p.data} />)}
      </div>
    </section>
  </main>
</Base>

<style>
  :global(body) { background: #000; }

  /* Camera spans the full screen width; the text sits on top in a black box. */
  .hero {
    position: relative;
    height: 700px;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 0 20px 20px 56px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 21px;
    max-width: var(--page-max);
    margin: 50px auto 60px;
    padding: 0 30px;
  }

  .hero__cam { position: absolute; inset: 0; overflow: hidden; }

  .hero__text {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: min(640px, 100%);
    padding: 28px 32px;
    background: #000;
    color: var(--paper);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-home-title);
    line-height: 0.943;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-home-lead);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .landing__text {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--paper);
  }

  /* Provisional stacked layout until a mobile design exists. */
  @media (max-width: 900px) {
    .hero { height: auto; min-height: 520px; }
    .hero__inner { min-height: 520px; padding: 0 14px 20px; }
    .projects__grid { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 16px; padding: 0 14px; }
    .hero__text { padding: 20px; }
    .hero__title { font-size: clamp(40px, 11vw, 70px); }
    .hero__lead { font-size: clamp(24px, 6.5vw, 40px); margin-top: 8px; }
  }
</style>
