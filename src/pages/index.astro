---
import Base from '../layouts/Base.astro';
import AsciiCam from '../components/AsciiCam.astro';
---
<Base>
  <main class="home">
    <section class="hero">
      <div class="hero__cam"><AsciiCam /></div>

      <div class="hero__text">
        <h1 class="hero__title">I create for humans</h1>
        <p class="hero__lead">Alison is a software engineer and designer that loves creating for humans.</p>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 44% minmax(0, 1fr);
    max-width: var(--page-max);
    margin: 0 auto;
    height: 635px;
  }

  .hero__cam { overflow: hidden; }

  .hero__text {
    padding: 132px 24px 0 48px;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-home-title);
    line-height: 0.943;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-home-lead);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Provisional stacked layout until a mobile design exists. */
  @media (max-width: 900px) {
    .hero {
      display: block;
      height: auto;
    }
    .hero__cam { height: 72vw; }
    .hero__text { padding: 28px 20px 48px; }
    .hero__title { font-size: clamp(40px, 11vw, 70px); }
    .hero__lead { font-size: clamp(24px, 6.5vw, 40px); margin-top: 8px; }
  }
</style>
