---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Dither from '../components/Dither.astro';
import cake from '../assets/about/abt-cake.png';
import comp from '../assets/about/abt-comp.png';
import goggle from '../assets/about/abt-goggle.png';
import ski from '../assets/about/abt-ski.png';
import snoopy from '../assets/about/abt-snoopy.png';
import cards from '../assets/about/abt-cards.png';
import matcha from '../assets/about/abt-matcha.png';
import miffy from '../assets/about/abt-miffy.png';
import mountain from '../assets/about/abt-mountain.png';

// x / y are % of the scatter area, rot in degrees, w in px (desktop).
const photos = [
  { src: cake, alt: 'Line drawing of a slice of cake with a black cherry on top.', x: 4, y: 12, rot: -6, w: 200 },
  { src: comp, alt: 'Line drawing of an open laptop.', x: 30, y: 5, rot: 4, w: 200 },
  { src: goggle, alt: 'Line drawing of ski goggles.', x: 58, y: 18, rot: -3, w: 190 },
  { src: ski, alt: 'Line drawing of a signpost reading Ski Patrol, Ski Lift and Apres Ski.', x: 75, y: 8, rot: 7, w: 210 },
  { src: snoopy, alt: 'Line drawing of a cartoon beagle with arms stretched wide.', x: 45, y: 45, rot: -5, w: 230 },
  { src: cards, alt: 'Line drawing of two playing cards, one with cats on it.', x: 18, y: 45, rot: 5, w: 230 },
  { src: matcha, alt: 'Line drawing of an iced matcha in a to-go cup.', x: 65, y: 50, rot: -4, w: 185 },
  { src: miffy, alt: 'Line drawing of a cartoon rabbit in a flowered dress.', x: 82, y: 54, rot: 3, w: 210 },
  { src: mountain, alt: 'Line drawing of a snowy mountain and sun.', x: 32, y: 62, rot: -7, w: 220 },
];
---
<Base title="About · Alison Zou" description="Alison Zou is a software developer, art creator, and digital expressionist living in Nashville, TN.">
  <main class="about">
    <section class="intro">
      <div class="intro__cam"><Dither /></div>
      <div class="intro__bio">
        <p>Alison Zou is a software developer, art creator, and digital expressionist living in Nashville, TN.</p>
        <p>She is a senior at Vanderbilt University studying Computer Science, Math, and Fine Arts. She is also available for volunteer and freelance work.</p>
        <p>In spare time she works on personal projects and loves cafe hunting. She also loves traveling to hike and see all of nature.</p>
        <p>She recently completed her software engineering internship at Goldman Sachs, and she believes community is key.</p>
        <a class="intro__link" href="https://www.linkedin.com/in/alison-zou/" target="_blank" rel="noopener">linkedin ↗</a>
      </div>
    </section>

    <section class="scatter" id="scatter" aria-label="Things I like. Drag them around.">
      {photos.map((p) => (
        <div class="scatter__item" data-rot={p.rot} style={`left:${p.x}%;top:${p.y}%;width:${p.w}px`}>
          <Image src={p.src} alt={p.alt} widths={[p.w, p.w * 2]} sizes={`${p.w}px`} format="webp" quality={85} draggable="false" />
        </div>
      ))}
    </section>
  </main>

  <script>
    import { gsap } from 'gsap';
    import { Draggable } from 'gsap/Draggable';
    import { InertiaPlugin } from 'gsap/InertiaPlugin';
    gsap.registerPlugin(Draggable, InertiaPlugin);

    const area = document.getElementById('scatter');
    const items = [...area.querySelectorAll('.scatter__item')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let z = 10;

    items.forEach((el) => gsap.set(el, { rotation: +el.dataset.rot }));

    // Entrance: drop in with a little overshoot once the area scrolls into view.
    const enter = () => {
      if (reduce) return;
      gsap.from(items, { y: -140, opacity: 0, rotation: () => gsap.utils.random(-25, 25), duration: 0.9, ease: 'back.out(1.5)', stagger: 0.07 });
    };
    new IntersectionObserver((es, io) => {
      if (es[0].isIntersecting) { enter(); io.disconnect(); }
    }, { threshold: 0.25 }).observe(area);

    // Idle float on an inner wobble so it never fights the drag transform.
    const bob = [];
    if (!reduce) {
      items.forEach((el, i) => {
        bob.push(gsap.to(el.firstElementChild, { y: gsap.utils.random(-8, 8), rotation: gsap.utils.random(-2, 2), duration: gsap.utils.random(2.2, 3.6), ease: 'sine.inOut', repeat: -1, yoyo: true, delay: i * 0.2 }));
      });
    }

    Draggable.create(items, {
      type: 'x,y',
      bounds: area,
      inertia: true,
      edgeResistance: 0.8,
      cursor: 'grab',
      activeCursor: 'grabbing',
      onPress() {
        this.target.style.zIndex = ++z;
        gsap.to(this.target, { scale: 1.06, duration: 0.2 });
        gsap.to(this.target.firstElementChild, { y: 0, rotation: 0, duration: 0.2, overwrite: true });
      },
      onRelease() {
        gsap.to(this.target, { scale: 1, duration: 0.3, ease: 'back.out(2)' });
      },
      onDrag() { gsap.to(this.target, { rotation: +this.target.dataset.rot + this.deltaX * 0.3, duration: 0.2, overwrite: 'auto' }); },
    });
  </script>
</Base>

<style>
  .about { background: var(--paper); }
  .intro { display: grid; grid-template-columns: 40% 60%; height: 600px; border-bottom: 1px solid var(--ink); }
  .intro__cam { background: #000; overflow: hidden; }
  .intro__bio { padding: 48px 56px; display: flex; flex-direction: column; max-width: 760px; }
  .intro__bio p { font: var(--fs-bio)/1.3 var(--font-serif); margin: 0 0 20px; }
  .intro__link { margin-top: auto; width: fit-content; font: var(--fs-label) var(--font-mono); border-bottom: 1px solid currentColor; }
  .intro__link:hover { opacity: 0.5; }
  .scatter { position: relative; height: 760px; max-width: var(--page-max); margin: 0 auto; overflow: hidden; touch-action: pan-y; }
  .scatter__item { position: absolute; user-select: none; will-change: transform; touch-action: none; }
  .scatter__item :global(img) { width: 100%; height: auto; pointer-events: none; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; height: auto; }
    .intro__cam { height: 56vw; }
    .intro__bio { padding: 28px 20px; }
    .scatter { height: 820px; }
    .scatter__item { width: 38vw !important; }
  }
</style>
