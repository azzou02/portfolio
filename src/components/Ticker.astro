---
const {
  text: phrase = 'Alison Zou circa 2005',
  size = 70,
  speed = 1,
  gap = 1,
  small = '',
  dark = false,
} = Astro.props;

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Wrap the chosen part (the emoji) in a span so it can be styled smaller.
const phraseHtml =
  small && phrase.includes(small)
    ? esc(phrase).replace(esc(small), `<span class="ticker__small">${esc(small)}</span>`)
    : esc(phrase);

const minChars = Math.ceil(12320 / size);
const repeats = Math.max(8, Math.ceil(minChars / (phrase.length + gap)));
const html = (phraseHtml + ' '.repeat(gap)).repeat(repeats);
const duration = ((phrase.length + gap) * repeats * size * 0.001943) / speed;
---

<div
  class={dark ? 'ticker ticker--dark' : 'ticker'}
  style={`--ticker-size: ${size}px; --ticker-duration: ${duration}s`}
  aria-hidden="true"
>
  <div class="ticker__track" set:html={html}></div>
  <div class="ticker__track" set:html={html}></div>
</div>

<style>
  .ticker {
    --fs: min(var(--ticker-size, 999px), var(--fs-ticker));
    display: flex;
    height: calc(var(--fs) * 1.214);
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    white-space: pre;
    font-family: var(--font-serif);
    font-size: var(--fs);
    line-height: 0.943;
    letter-spacing: -0.03em;
    word-spacing: 0.5px;
    padding-top: calc(var(--fs) * 0.129);
  }

  .ticker--dark {
    background: #000;
    color: #fff;
  }

  .ticker__track {
    flex: none;
    animation: ticker-scroll var(--ticker-duration, 24s) linear infinite;
  }

  /* :global is needed because set:html content doesn't get Astro's scope attribute */
  .ticker :global(.ticker__small) {
    font-size: 0.6em;
    vertical-align: 0.15em;
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; }
  }

  @media (max-width: 900px) {
    .ticker { --fs-ticker: 46px; }
  }
</style>