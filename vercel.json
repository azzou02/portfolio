{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/code", "destination": "/fun", "permanent": true },
    { "source": "/code/:path*", "destination": "/fun", "permanent": true },
    { "source": "/graphics", "destination": "/fun", "permanent": true },
    { "source": "/paintings", "destination": "/fun", "permanent": true },
    { "source": "/uiux", "destination": "/work", "permanent": true },
    { "source": "/uiux/:path*", "destination": "/work", "permanent": true }
  ]
}
